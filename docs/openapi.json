{
  "openapi": "3.1.0",
  "info": {
    "title": "Bus Terminals API",
    "summary": "Bus terminal and bus ticket management",
    "description": "\nUpstream bus terminal service. Exposes the terminals and the bus tickets\nsold at them, and is consumed by the main backend\n(`EXTERNAL_TERMINAL_UPSTREAM_URL`) and, through it, by the OCR microservice.\n\n**Authentication:** none. It is an internal service reachable only from the system network.\n\n**Dates:** ISO 8601 (`2026-03-30T06:00:00`). Dates without a time zone are\ninterpreted exactly as stored in the database.\n\n**Errors:** error responses have the shape `{\"detail\": \"...\"}`. Validation\nerrors (422) follow the standard FastAPI format.\n",
    "version": "1.0.0"
  },
  "paths": {
    "/bus_tickets/{ticket}": {
      "get": {
        "tags": [
          "Bus Tickets"
        ],
        "summary": "Get bus ticket by ticket code",
        "description": "Returns the full data of a bus ticket (passenger, bus, dates and\nstops). The main backend consumes it when a user registers for a\ntrip.",
        "operationId": "get_bus_ticket_by_ticket_bus_tickets__ticket__get",
        "parameters": [
          {
            "name": "ticket",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Ticket"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BusTicketResponse"
                }
              }
            }
          },
          "404": {
            "description": "No bus ticket exists with that code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/bus_tickets/": {
      "post": {
        "tags": [
          "Bus Tickets"
        ],
        "summary": "Create bus ticket",
        "description": "Registers a new bus ticket. The `ticket` code must be unique and\n`terminal_uuid` must reference an existing terminal.",
        "operationId": "create_bus_ticket_bus_tickets__post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BusTicketCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BusTicketResponse"
                }
              }
            }
          },
          "404": {
            "description": "The given terminal does not exist",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "A bus ticket with that ticket code already exists",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/terminal/": {
      "get": {
        "tags": [
          "Terminal"
        ],
        "summary": "List terminals",
        "description": "All registered terminals, ordered by name.",
        "operationId": "list_terminals_terminal__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/TerminalItem"
                  },
                  "type": "array",
                  "title": "Response List Terminals Terminal  Get"
                }
              }
            }
          }
        }
      }
    },
    "/terminal/exist/": {
      "get": {
        "tags": [
          "Terminal"
        ],
        "summary": "Check whether a terminal exists",
        "description": "Tells whether a terminal with that UUID exists. The main backend uses it\nbefore creating an associated internal terminal.",
        "operationId": "exist_terminal_terminal_exist__get",
        "parameters": [
          {
            "name": "uuid",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "description": "Terminal UUID",
              "title": "Uuid"
            },
            "description": "Terminal UUID"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExistTerminalResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/terminal/trip/exist/": {
      "get": {
        "tags": [
          "Terminal"
        ],
        "summary": "Check whether a trip exists on a date",
        "description": "Tells whether the terminal has a bus ticket with that license plate whose\ntrip overlaps the calendar day of `start_date` (00:00–24:00 of that\ndate). The main backend uses it before sending delay\nnotifications.",
        "operationId": "exist_trip_terminal_trip_exist__get",
        "parameters": [
          {
            "name": "uuid",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "description": "Terminal UUID",
              "title": "Uuid"
            },
            "description": "Terminal UUID"
          },
          {
            "name": "license_plate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Bus license plate",
              "title": "License Plate"
            },
            "description": "Bus license plate"
          },
          {
            "name": "start_date",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time",
              "description": "Any instant of the calendar day to check (e.g. 2026-03-30)",
              "title": "Start Date"
            },
            "description": "Any instant of the calendar day to check (e.g. 2026-03-30)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExistTerminalResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/terminal/trip/": {
      "get": {
        "tags": [
          "Terminal"
        ],
        "summary": "List a terminal's trips in a range",
        "description": "Returns the terminal's trips that overlap the range\n`[start_date, end_date]`, ordered by departure. The OCR microservice\nuses it (through the main backend) to know which buses are expected.",
        "operationId": "get_bus_tickets_by_terminal_terminal_trip__get",
        "parameters": [
          {
            "name": "uuid",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "description": "Terminal UUID",
              "title": "Uuid"
            },
            "description": "Terminal UUID"
          },
          {
            "name": "start_date",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time",
              "description": "Range start (inclusive)",
              "title": "Start Date"
            },
            "description": "Range start (inclusive)"
          },
          {
            "name": "end_date",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time",
              "description": "Range end (inclusive)",
              "title": "End Date"
            },
            "description": "Range end (inclusive)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TerminalBusTicketsResponse"
                }
              }
            }
          },
          "400": {
            "description": "`start_date` is after `end_date`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "The terminal does not exist",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Health check",
        "description": "Returns `OK` as plain text if the service is up.",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                },
                "example": "OK"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BusTicketCreate": {
        "properties": {
          "postal_code": {
            "type": "string",
            "title": "Postal Code",
            "description": "Postal code of the origin terminal",
            "examples": [
              "2000"
            ]
          },
          "terminal_uuid": {
            "type": "string",
            "title": "Terminal Uuid",
            "description": "UUID of the terminal the bus ticket belongs to",
            "examples": [
              "c2bcc293-5b53-4bb2-963c-8f5fe0b91373"
            ]
          },
          "ticket": {
            "type": "string",
            "title": "Ticket",
            "description": "Ticket code (unique)",
            "examples": [
              "TKT-000123"
            ]
          },
          "dni": {
            "type": "string",
            "title": "Dni",
            "description": "Passenger DNI (national ID)",
            "examples": [
              "40123456"
            ]
          },
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Passenger full name",
            "examples": [
              "Juan Pérez"
            ]
          },
          "bus_license_plate": {
            "type": "string",
            "title": "Bus License Plate",
            "description": "Bus license plate",
            "examples": [
              "AB123CD"
            ]
          },
          "enterprise": {
            "type": "string",
            "title": "Enterprise",
            "description": "Transport company",
            "examples": [
              "Flecha Bus"
            ]
          },
          "start_date": {
            "type": "string",
            "format": "date-time",
            "title": "Start Date",
            "description": "Trip departure date and time",
            "examples": [
              "2026-03-30T06:00:00"
            ]
          },
          "end_date": {
            "type": "string",
            "format": "date-time",
            "title": "End Date",
            "description": "Trip arrival date and time",
            "examples": [
              "2026-03-30T14:00:00"
            ]
          },
          "trip_city": {
            "items": {
              "$ref": "#/components/schemas/TripCity"
            },
            "type": "array",
            "title": "Trip City",
            "description": "Intermediate stops of the route, ordered by `order`"
          }
        },
        "type": "object",
        "required": [
          "postal_code",
          "terminal_uuid",
          "ticket",
          "dni",
          "name",
          "bus_license_plate",
          "enterprise",
          "start_date",
          "end_date",
          "trip_city"
        ],
        "title": "BusTicketCreate"
      },
      "BusTicketResponse": {
        "properties": {
          "postal_code": {
            "type": "string",
            "title": "Postal Code",
            "description": "Postal code of the origin terminal",
            "examples": [
              "2000"
            ]
          },
          "terminal_uuid": {
            "type": "string",
            "title": "Terminal Uuid",
            "description": "UUID of the terminal the bus ticket belongs to",
            "examples": [
              "c2bcc293-5b53-4bb2-963c-8f5fe0b91373"
            ]
          },
          "ticket": {
            "type": "string",
            "title": "Ticket",
            "description": "Ticket code (unique)",
            "examples": [
              "TKT-000123"
            ]
          },
          "dni": {
            "type": "string",
            "title": "Dni",
            "description": "Passenger DNI (national ID)",
            "examples": [
              "40123456"
            ]
          },
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Passenger full name",
            "examples": [
              "Juan Pérez"
            ]
          },
          "bus_license_plate": {
            "type": "string",
            "title": "Bus License Plate",
            "description": "Bus license plate",
            "examples": [
              "AB123CD"
            ]
          },
          "enterprise": {
            "type": "string",
            "title": "Enterprise",
            "description": "Transport company",
            "examples": [
              "Flecha Bus"
            ]
          },
          "start_date": {
            "type": "string",
            "format": "date-time",
            "title": "Start Date",
            "description": "Trip departure date and time",
            "examples": [
              "2026-03-30T06:00:00"
            ]
          },
          "end_date": {
            "type": "string",
            "format": "date-time",
            "title": "End Date",
            "description": "Trip arrival date and time",
            "examples": [
              "2026-03-30T14:00:00"
            ]
          },
          "trip_city": {
            "items": {
              "$ref": "#/components/schemas/TripCity"
            },
            "type": "array",
            "title": "Trip City",
            "description": "Intermediate stops of the route, ordered by `order`"
          },
          "uuid": {
            "type": "string",
            "title": "Uuid",
            "description": "Generated bus ticket identifier",
            "examples": [
              "3f1c9a52-8d0e-4b7a-9e61-2a4c5d6e7f80"
            ]
          }
        },
        "type": "object",
        "required": [
          "postal_code",
          "terminal_uuid",
          "ticket",
          "dni",
          "name",
          "bus_license_plate",
          "enterprise",
          "start_date",
          "end_date",
          "trip_city",
          "uuid"
        ],
        "title": "BusTicketResponse"
      },
      "ErrorResponse": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail",
            "description": "Error message",
            "examples": [
              "Terminal not found"
            ]
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorResponse"
      },
      "ExistTerminalResponse": {
        "properties": {
          "exist": {
            "type": "boolean",
            "title": "Exist",
            "description": "`true` if the requested resource exists",
            "examples": [
              true
            ]
          }
        },
        "type": "object",
        "required": [
          "exist"
        ],
        "title": "ExistTerminalResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "TerminalBusTicketItem": {
        "properties": {
          "license_plate": {
            "type": "string",
            "title": "License Plate",
            "description": "Bus license plate",
            "examples": [
              "AB123CD"
            ]
          },
          "enterprise": {
            "type": "string",
            "title": "Enterprise",
            "description": "Transport company",
            "examples": [
              "Flecha Bus"
            ]
          },
          "start_date": {
            "type": "string",
            "title": "Start Date",
            "description": "Trip departure (ISO 8601)",
            "examples": [
              "2026-03-30T06:00:00"
            ]
          },
          "end_date": {
            "type": "string",
            "title": "End Date",
            "description": "Trip arrival (ISO 8601)",
            "examples": [
              "2026-03-30T14:00:00"
            ]
          }
        },
        "type": "object",
        "required": [
          "license_plate",
          "enterprise",
          "start_date",
          "end_date"
        ],
        "title": "TerminalBusTicketItem"
      },
      "TerminalBusTicketsResponse": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Terminal name",
            "examples": [
              "Terminal Córdoba"
            ]
          },
          "payload": {
            "items": {
              "$ref": "#/components/schemas/TerminalBusTicketItem"
            },
            "type": "array",
            "title": "Payload",
            "description": "Trips that overlap the requested range"
          }
        },
        "type": "object",
        "required": [
          "name",
          "payload"
        ],
        "title": "TerminalBusTicketsResponse"
      },
      "TerminalItem": {
        "properties": {
          "uuid": {
            "type": "string",
            "title": "Uuid",
            "description": "Terminal UUID",
            "examples": [
              "c2bcc293-5b53-4bb2-963c-8f5fe0b91373"
            ]
          },
          "terminal": {
            "type": "string",
            "title": "Terminal",
            "description": "Terminal name",
            "examples": [
              "Terminal Córdoba"
            ]
          }
        },
        "type": "object",
        "required": [
          "uuid",
          "terminal"
        ],
        "title": "TerminalItem"
      },
      "TripCity": {
        "properties": {
          "city_name": {
            "type": "string",
            "title": "City Name",
            "description": "Name of the route city",
            "examples": [
              "Rosario"
            ]
          },
          "start_date": {
            "type": "string",
            "format": "date-time",
            "title": "Start Date",
            "description": "Arrival at the city",
            "examples": [
              "2026-03-30T08:00:00"
            ]
          },
          "end_date": {
            "type": "string",
            "format": "date-time",
            "title": "End Date",
            "description": "Departure from the city",
            "examples": [
              "2026-03-30T08:20:00"
            ]
          },
          "order": {
            "type": "integer",
            "title": "Order",
            "description": "Position of the stop in the route (1 = first)",
            "examples": [
              1
            ]
          }
        },
        "type": "object",
        "required": [
          "city_name",
          "start_date",
          "end_date",
          "order"
        ],
        "title": "TripCity"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  },
  "tags": [
    {
      "name": "Bus Tickets",
      "description": "Look up and create bus tickets by ticket code."
    },
    {
      "name": "Terminal",
      "description": "Terminals and the trips associated with each one."
    },
    {
      "name": "Health",
      "description": "Service status."
    }
  ]
}
